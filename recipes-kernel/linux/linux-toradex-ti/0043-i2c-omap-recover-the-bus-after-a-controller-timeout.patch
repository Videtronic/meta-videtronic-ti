+static void omap_i2c_unwedge(struct omap_i2c_dev *omap)
+{
+	unsigned long timeout = jiffies + msecs_to_jiffies(50);
+	u16 systest;
+	bool idle;
+
+	for (;;) {
+		systest = omap_i2c_read_reg(omap, OMAP_I2C_SYSTEST_REG);
+		idle = (systest & OMAP_I2C_SYSTEST_SCL_I_FUNC) &&
+		       (systest & OMAP_I2C_SYSTEST_SDA_I_FUNC);
+		if (idle || time_after(jiffies, timeout))
+			break;
+		usleep_range(100, 200);
+	}
+
+	if (!idle) {
+		dev_warn(omap->dev,
+			 "bus wedged after timeout (systest 0x%04x), forcing recovery\n",
+			 systest);
+		i2c_recover_bus(&omap->adapter);
+	}
+
+	omap_i2c_reset(omap);
+	__omap_i2c_init(omap);
+	/* re-arm the bus monitor: the BB bit is meaningless after a reset */
+	omap->bb_valid = 0;
+}
